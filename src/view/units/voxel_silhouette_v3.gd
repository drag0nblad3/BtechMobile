class_name VoxelSilhouetteV3
extends RefCounted
## Sculpt references: CGL/Sarna TRO views for AS7-D, HBK-4G, WVR-6R,
## JR7-D and CPLT-C1. Shape grammar, not a universal biped template.
##
## Y is up, -Z is forward. Coarse 75mm authoring grid, then the existing
## per-part real microvoxels are generated by VoxelPart.seal().
## No rule engine inputs. All geometry stays destructible.


## Bevelled rectangular prism that can taper between hip/shoulder widths.
## Compared to the generic ellipsoid this gives distinct flat armor facets.
static func loft(p: VoxelPart, low: int, high: int,
		bottom: Vector2, top: Vector2,
		center_z: float, armor: int, core: int = 1,
		offset_x: float = 0.0, bevel: float = 0.20) -> void:
	for y in range(low, high + 1):
		var t := float(y - low) / maxf(1.0, float(high - low))
		var radii := bottom.lerp(top, t)
		for x in range(floori(offset_x - radii.x), ceili(offset_x + radii.x) + 1):
			for z in range(floori(center_z - radii.y), ceili(center_z + radii.y) + 1):
				var dx := absf(float(x) - offset_x) / radii.x
				var dz := absf(float(z) - center_z) / radii.y
				if maxf(dx, dz) + minf(dx, dz) * bevel > 1.0:
					continue
				var shell := maxf(dx, dz) + minf(dx, dz) * bevel > 0.72
				p.cells[Vector3i(x, y, z)] = armor if shell else core


## Cross-section along the limb, never a spherical glove glued to a sphere.
static func plated_limb(p: VoxelPart, low: int, high: int,
		width_bottom: float, width_top: float,
		depth: float, front_z: float, armor: int,
		offset_x: float = 0.0) -> void:
	loft(p, low, high, Vector2(width_bottom, depth),
			Vector2(width_top, depth * 0.86), front_z,
			armor, 1, offset_x, 0.28)


static func torso(p: VoxelPart, shape: String) -> void:
	match shape:
		"atlas":
			_atlas_torso(p)
		"hunchback":
			_hunchback_torso(p)
		"wolverine":
			_wolverine_torso(p)
		"jenner":
			_jenner_torso(p)
		"catapult":
			_catapult_torso(p)
		"prototype":
			_prototype_torso(p)


static func _atlas_torso(p: VoxelPart) -> void:
	# A squat death's-head sits BETWEEN enormous shoulder blocks, not above
	# the body like a huge disconnected skull on a stalk.
	p.carve_box(Vector3i(-7, 11, -11), Vector3i(6, 16, 0))
	for y in range(10, 13):
		var half := 3 if y == 12 else (4 if y == 11 else 5)
		p.fill_box(Vector3i(-half, y, -6), Vector3i(half - 1, y, -3), 6)
	p.fill_box(Vector3i(-3, 4, -4), Vector3i(2, 6, 0), 8)
	# Return the recessed eye line to a darker socket with bone brow and
	# cheekbones above it; eye lights remain split, asymmetric points.
	for eye in [-3, 2]:
		p.carve_box(Vector3i(eye - 1, 8, -11),
				Vector3i(eye + 1, 10, -8))
		p.fill_box(Vector3i(eye, 9, -8), Vector3i(eye, 9, -8), 7)
	# Chest should read as one deep armored breastplate, NOT two footballs.
	# Several extra projecting plates define a narrow centerline.
	for side in [-1, 1]:
		var x0 := -9 if side < 0 else 1
		var x1 := -2 if side < 0 else 8
		loft(p, -6, 1, Vector2(3.4, 1.2),
				Vector2(4.2, 1.3), -7.5, 4, 1,
				float((x0 + x1) / 2), 0.30)
	for y in [-4, 0]:
		p.carve_box(Vector3i(-7, y, -9), Vector3i(7, y, -9))
	# Elongated rear engine bays; no more featureless blue disk shoulders.
	for side in [-1, 1]:
		var x := -13 if side < 0 else 11
		for y in [-2, 0, 2]:
			p.carve_box(Vector3i(x, y, 8), Vector3i(x + 1, y, 10))
	# Distinct armored hip apron.
	p.fill_box(Vector3i(-3, -10, -5), Vector3i(2, -9, -5), 8)


static func _hunchback_torso(p: VoxelPart) -> void:
	# Squared autocannon carriage, as in the classic technical readout:
	# a giant RECTANGULAR mass over the right shoulder, not a round hump.
	for x in range(2, 14):
		for y in range(4, 13):
			for z in range(-5, 7):
				if Vector2(float(x - 7), float(y - 7)).length() > 5.5:
					p.cells.erase(Vector3i(x, y, z))
	loft(p, 3, 12, Vector2(5.7, 5.5), Vector2(5.0, 5.0),
			0, 4, 1, 7.0, 0.15)
	# A cuboid housing with cut corners, side radiator and thick cannon
	# protrusion -- preserve a real hole through the forward barrel.
	p.fill_box(Vector3i(4, 7, -8), Vector3i(10, 10, -6), 8)
	VoxelAnatomyV2.tube(p, 7, 6, -17, -6, 3.0, 1.5, 8)
	for y in [4, 6, 8]:
		p.carve_box(Vector3i(12, y, 1), Vector3i(13, y, 4))
	# Lower left side has its own little torso and recessed small cockpit.
	p.fill_box(Vector3i(-5, 3, -7), Vector3i(-1, 7, -5), 4)
	p.fill_box(Vector3i(-4, 5, -8), Vector3i(-1, 6, -7), 2)
	p.fill_box(Vector3i(-4, 7, -8), Vector3i(-2, 7, -7), 8)
	# Tall right-side AC mount must dwarf left cockpit.
	p.fill_box(Vector3i(10, 8, 2), Vector3i(13, 11, 4), 4)


static func _wolverine_torso(p: VoxelPart) -> void:
	# A comparatively slim medium mech; tall window and separate missile
	# rack beside (not covering) the head. The torso must not read as Atlas.
	for x in range(-13, 14):
		for y in range(3, 10):
			if abs(x) > 8:
				for z in range(-5, 5):
					p.cells.erase(Vector3i(x, y, z))
	# Upright canopy, high in the body and markedly different from Atlas skull.
	loft(p, 4, 10, Vector2(2.7, 3.0), Vector2(2.0, 2.5),
			-4.8, 4, 1, 0.0, 0.3)
	p.fill_box(Vector3i(-2, 6, -9), Vector3i(1, 8, -8), 2)
	p.fill_box(Vector3i(-1, 6, -10), Vector3i(0, 8, -9), 1)
	p.fill_box(Vector3i(-3, 9, -7), Vector3i(2, 9, -5), 8)
	# Raised six-pack rockets next to the cockpit. True separate front voids.
	p.fill_box(Vector3i(-14, 1, -7), Vector3i(-8, 7, -6), 9)
	for x in [-13, -11, -9]:
		for y in [2, 5]:
			p.carve_box(Vector3i(x, y, -9), Vector3i(x, y, -6))
			p.fill_box(Vector3i(x, y, -5), Vector3i(x, y, -5), 3)
	p.fill_box(Vector3i(-13, 8, -6), Vector3i(-8, 8, -2), 8)
	# A small sensor tower, not a jaw/face made from the Atlas primitive.
	p.fill_box(Vector3i(2, 10, -3), Vector3i(3, 12, -2), 8)
	p.fill_box(Vector3i(2, 12, -3), Vector3i(3, 12, -2), 2)


static func _jenner_torso(p: VoxelPart) -> void:
	# The cockpit is a full forward-facing wedge, more like a low aircraft
	# nose. Its paired SIDE laser engines live on the sides, not as arms.
	for z in range(-23, -17):
		var half := 1 if z < -21 else 2
		var top := 0 if z < -20 else 1
		p.fill_box(Vector3i(-half, -1, z),
				Vector3i(half - 1, top, z), 4)
		p.fill_box(Vector3i(-half + 1, top, z),
				Vector3i(half - 2, top, z), 2)
	# Stop the side fairings looking like featureless rectangular blocks:
	# cut top rear corners along both swept engine housings.
	for side in [-1, 1]:
		var edge := -11 if side < 0 else 10
		for z in range(1, 8):
			p.carve_box(Vector3i(edge, 2, z), Vector3i(edge, 3, z))
	# A contrasting tapered armored belly, above the digitigrade hips.
	loft(p, -7, -5, Vector2(3.2, 2.7), Vector2(4.0, 3.1),
			0, 8, 1)


static func _catapult_torso(p: VoxelPart) -> void:
	# A low airplane-like beak between the distinctive twin racks.
	# Keep the glazing narrowly on the beak; the old bright cyan cockpit
	# occupied nearly the entire front fuselage.
	for c: Vector3i in p.cells.keys():
		if int(p.cells[c]) != 2:
			continue
		if c.x < -2 or c.x > 1 or c.y < 1 or c.y > 4:
			p.cells[c] = 4
	# Narrow recessed windshield and wedge tip.
	p.fill_box(Vector3i(-2, 2, -12), Vector3i(1, 3, -11), 2)
	p.fill_box(Vector3i(-1, 1, -15), Vector3i(0, 1, -14), 2)
	for z in range(-17, -11):
		var r := 1 if z < -15 else (2 if z < -13 else 3)
		p.fill_box(Vector3i(-r, -1, z),
				Vector3i(r - 1, 0, z), 4)
	# Rear rotary jet nacelles (two separated from the cockpit by an open gap).
	for side in [-1, 1]:
		var x := -7 if side < 0 else 6
		p.fill_box(Vector3i(x, -1, 7), Vector3i(x + 1, 2, 10), 8)
		for yy in [0, 2]:
			p.carve_box(Vector3i(x, yy, 10), Vector3i(x + 1, yy, 10))


static func _prototype_torso(p: VoxelPart) -> void:
	# Tool-mech prototype should never resemble an Atlas/Wolverine torso:
	# a narrow vertical machine-spine with one offset test instrument rig.
	for side in [-1, 1]:
		var x := -10 if side < 0 else 9
		for z in range(2, 6):
			p.carve_box(Vector3i(x, 3, z), Vector3i(x, 5, z))
	# A tall split optical array on a column with a side antenna.
	p.fill_box(Vector3i(-2, 8, 0), Vector3i(2, 11, 3), 8)
	p.fill_box(Vector3i(-1, 9, -1), Vector3i(0, 10, -1), 2)
	p.fill_box(Vector3i(3, 10, 1), Vector3i(3, 14, 1), 8)
	p.fill_box(Vector3i(3, 14, 1), Vector3i(3, 14, 1), 3)


static func arm(p: VoxelPart, shape: String, side: int) -> void:
	match shape:
		"jenner":
			_jenner_nacelle(p)
			return
		"catapult":
			_catapult_rack(p)
			return
	# All humanoid arms are genuinely independent geometry, not the same
	# sphere stack at different scales. Hand vs gun is part of the silhouette.
	p.cells.clear()
	match shape:
		"atlas":
			_atlas_arm(p, side)
		"hunchback":
			_hunchback_arm(p, side)
		"wolverine":
			_wolverine_arm(p, side)
		_:
			_prototype_arm(p, side)


static func _atlas_arm(p: VoxelPart, side: int) -> void:
	# Big armored pauldrons, slimmer elbow shafts, large articulated fists.
	VoxelAnatomyV2.ellipsoid(p, Vector3(0, 0, 0),
			Vector3(5.2, 3.4, 4.9), 4)
	plated_limb(p, -8, -2, 4.2, 3.0, 3.2, 0.0, 0)
	VoxelAnatomyV2.ring_x(p, -5, 5, -6, 0, 2.6, 1.3, 8)
	plated_limb(p, -12, -8, 5.0, 4.2, 3.5, -1, 4)
	for x in [-3, 0, 3]:
		p.fill_box(Vector3i(x, -13, -4), Vector3i(x + 1, -11, -2), 8)
	for x in [-1, 2]:
		p.carve_box(Vector3i(x, -13, -4), Vector3i(x, -12, -3))
	# Only the right fist has an exposed small-laser face.
	if side == 1:
		VoxelAnatomyV2.tube(p, 0, -10, -8, -5, 2.1, 0.7, 8)
	else:
		p.fill_box(Vector3i(-3, -13, -5), Vector3i(2, -12, -5), 4)


static func _hunchback_arm(p: VoxelPart, side: int) -> void:
	# Much shorter arms than Atlas. Cannon stays in RIGHT shoulder.
	plated_limb(p, -6, 1, 3.5, 3.6, 3.0, 0, 0)
	VoxelAnatomyV2.ring_x(p, -4, 4, -6, 0, 2.2, 1.2, 8)
	plated_limb(p, -10, -7, 3.8, 3.0, 3.2, -1, 4)
	if side == 1:
		VoxelAnatomyV2.tube(p, 0, -6, -11, -6, 2.4, 0.7, 8)
	else:
		for x in [-3, 0, 3]:
			p.fill_box(Vector3i(x, -12, -5), Vector3i(x + 1, -11, -3), 4)


static func _wolverine_arm(p: VoxelPart, side: int) -> void:
	# Tall narrow forearms, distinct autocannon on the RIGHT and gripping
	# manipulator on the LEFT. Reference head is upright and shoulders compact.
	plated_limb(p, -7, 1, 3.2, 4.2, 3.0, 0, 4)
	VoxelAnatomyV2.ring_x(p, -4, 4, -7, 0, 2.2, 1.2, 8)
	plated_limb(p, -12, -8, 3.9, 3.3, 2.8, 0, 0)
	if side == 1:
		VoxelAnatomyV2.tube(p, 0, -6, -17, -7, 4.7, 1.1, 8)
	else:
		for x in [-3, 0, 3]:
			p.fill_box(Vector3i(x, -12, -4), Vector3i(x + 1, -10, -2), 4)
		p.fill_box(Vector3i(4, -11, -3), Vector3i(4, -11, -3), 4)


static func _prototype_arm(p: VoxelPart, side: int) -> void:
	# Experiment chassis: asymmetric instrument cannon and articulated claw.
	plated_limb(p, -7, 1, 3.1, 3.9, 3.0, 0, 4)
	VoxelAnatomyV2.ring_x(p, -4, 4, -7, 0, 2.3, 1.0, 8)
	if side == 0:
		VoxelAnatomyV2.tube(p, 0, -7, -13, -5, 4.5, 1.5, 8)
	else:
		for x in [-3, 1]:
			p.fill_box(Vector3i(x, -13, -6), Vector3i(x + 1, -9, -4), 8)
		p.fill_box(Vector3i(-1, -10, -7), Vector3i(1, -8, -6), 2)


static func _jenner_nacelle(p: VoxelPart) -> void:
	# Keep the two existing working laser emitters, but reduce the chunky
	# shoulder cube by bevel-cutting its outer upper and rear corners.
	for x in [-5, 4]:
		for z in [3, 4, 5]:
			p.carve_box(Vector3i(x, 1, z), Vector3i(x, 3, z))
	# A real air gap separates the two independent emitter housings.
	p.carve_box(Vector3i(-3, 0, -9), Vector3i(2, 0, -4))
	for y in [-2, 1]:
		p.fill_box(Vector3i(-3, y - 1, -10),
				Vector3i(2, y + 1, -10), 8)
		p.carve_box(Vector3i(-2, y, -11), Vector3i(1, y, -10))
		p.fill_box(Vector3i(-2, y, -9), Vector3i(1, y, -9), 2)


static func _catapult_rack(p: VoxelPart) -> void:
	# Leave all 15 25mm negative-space launch tubes untouched. Trim the
	# upper corners of the housing before the fine port pattern is built.
	for x in [-5, 5]:
		for y in [4, 5]:
			p.carve_box(Vector3i(x, y, -4), Vector3i(x, y, 4))
	# Side armor bulges + open radiator channels on the aft face.
	for x in [-5, 5]:
		p.fill_box(Vector3i(x, -2, 0), Vector3i(x, 3, 4), 8)
		for y in [-1, 1, 3]:
			p.carve_box(Vector3i(x, y, 4), Vector3i(x, y, 4))
	p.fill_box(Vector3i(-3, 6, -2), Vector3i(3, 6, 3), 4)


static func leg(p: VoxelPart, shape: String, segment: String) -> void:
	if shape == "jenner":
		_jenner_leg(p, segment)
		return
	# The Catapult has bird-leg joints and a long hock. Humanoid frames have
	# full anatomical armor extending from hip to knee, not small kneecaps.
	p.cells.clear()
	if shape == "catapult":
		_catapult_leg(p, segment)
	else:
		_humanoid_leg(p, shape, segment)


static func _humanoid_leg(p: VoxelPart, shape: String, segment: String) -> void:
	var heavy := 1.25 if shape == "atlas" else (
			1.06 if shape == "hunchback" else (0.93 if shape == "wolverine" else 0.88))
	match segment:
		"thigh":
			plated_limb(p, -10, -1, 3.3 * heavy, 5.4 * heavy,
					3.1, -0.1, 0)
			# Massive protruding armor knee and exposed hip bearings.
			VoxelAnatomyV2.ring_x(p, -5, 5, -1, 0, 2.7, 1.2, 8)
			VoxelAnatomyV2.ring_x(p, -5, 5, -9, 0, 2.7, 1.2, 8)
			for y in [-7, -5]:
				p.fill_box(Vector3i(-3, y, -5), Vector3i(3, y + 1, -4), 4)
			p.fill_box(Vector3i(0, -4, -5), Vector3i(0, -4, -5), 4)
			for x in [-4, 4]:
				p.fill_box(Vector3i(x, -7, 2), Vector3i(x, -2, 3), 8)
		"shin":
			plated_limb(p, -10, 0, 4.7 * heavy, 3.3 * heavy,
					3.0, 0, 0)
			VoxelAnatomyV2.ring_x(p, -5, 5, -1, 0, 2.7, 1.2, 8)
			for y in range(-9, -2):
				var width := 2 if y < -6 else 3
				p.fill_box(Vector3i(-width, y, -5),
						Vector3i(width, y, -4), 4)
			for x in [-4, 4]:
				p.fill_box(Vector3i(x, -8, 3), Vector3i(x, -3, 4), 8)
				p.carve_box(Vector3i(x, -6, 3), Vector3i(x, -5, 3))
			# Strong ankle shaft rather than a detached dot.
			p.fill_box(Vector3i(-2, -10, -1), Vector3i(2, -10, 2), 8)
		"foot":
			plated_limb(p, -2, 1, 4.4 * heavy, 4.5 * heavy, 5.8, -3, 0)
			for x in [-4, 0, 4]:
				p.fill_box(Vector3i(x, -2, -13),
						Vector3i(x + 1, -1, -9), 4)
				p.fill_box(Vector3i(x, -2, -14), Vector3i(x, -2, -14), 0)
			for x in [-2, 2]:
				p.carve_box(Vector3i(x, -2, -14),
						Vector3i(x, -1, -10))
			p.fill_box(Vector3i(-3, -1, 4), Vector3i(3, 0, 6), 8)


static func _catapult_leg(p: VoxelPart, segment: String) -> void:
	match segment:
		"thigh":
			# Short deep hip casing and exposed lateral hinge rings.
			plated_limb(p, -10, -1, 3.4, 4.5, 3.4, 0, 4)
			VoxelAnatomyV2.ring_x(p, -5, 5, -1, 0, 3.0, 1.5, 8)
			for x in [-4, 4]:
				p.fill_box(Vector3i(x, -8, 2), Vector3i(x, -2, 4), 8)
		"shin":
			# Backward-sloping hock protected by thin anterior armor.
			plated_limb(p, -10, 0, 3.1, 3.8, 2.7, 1, 4)
			VoxelAnatomyV2.ring_x(p, -5, 5, 0, 0, 2.6, 1.1, 8)
			for x in [-3, 3]:
				p.fill_box(Vector3i(x, -9, 4), Vector3i(x, -2, 5), 8)
			p.fill_box(Vector3i(-2, -10, 2), Vector3i(2, -10, 4), 8)
		"foot":
			# Broad bird toes with actual gaps, unlike humanoid boots.
			p.fill_box(Vector3i(-4, -1, -4), Vector3i(4, 0, 4), 4)
			for x in [-4, 0, 4]:
				p.fill_box(Vector3i(x, -2, -12),
						Vector3i(x + 1, -1, -4), 4)
				p.fill_box(Vector3i(x, -2, -13),
						Vector3i(x, -2, -13), 8)
			p.fill_box(Vector3i(-3, -2, 4), Vector3i(3, -1, 6), 8)


static func _jenner_leg(p: VoxelPart, segment: String) -> void:
	match segment:
		"thigh":
			# Accent narrow mechanical knee, without erasing three-link rig.
			for x in [-4, 4]:
				p.fill_box(Vector3i(x, -6, -3),
						Vector3i(x, -4, -2), 8)
		"shin":
			for x in [-3, 3]:
				p.fill_box(Vector3i(x, -9, -4),
						Vector3i(x, -7, -4), 4)
		"metatarsal":
			for x in [-3, 3]:
				p.fill_box(Vector3i(x, -3, 1),
						Vector3i(x, -1, 2), 8)
		"foot":
			# Three independent long toes remain apart at the tips.
			for x in [-3, 0, 3]:
				p.fill_box(Vector3i(x, -2, -10), Vector3i(x, -2, -10), 0)
